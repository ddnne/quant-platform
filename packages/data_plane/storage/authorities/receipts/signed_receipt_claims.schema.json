{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/receipts/signed_receipt_claims.schema.json",
  "title": "SignedCollectionClosureClaimsV3",
  "description": "Closed signed claims for a COMPLETE-eligible collection closure. Persisted CollectionReceipt columns are untrusted mirrors; every value used by coverage policy is signed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "environment",
    "authority_instance_digest",
    "coverage_policy_version",
    "source",
    "dataset",
    "segment_id",
    "segment_start",
    "segment_end",
    "expected_scope",
    "expected_items",
    "observed_items",
    "raw_page_count",
    "raw_count",
    "structured_count",
    "status",
    "error",
    "pagination_exhausted",
    "discovery_exhausted",
    "source_request_digest",
    "raw_manifest_digest",
    "raw_digest",
    "structured_digest",
    "parser_normalizer_version",
    "structured_generation",
    "scope_digest",
    "observation_digest",
    "run_id",
    "issuer_id",
    "issued_at",
    "checked_at",
    "extra_digests"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    }
  },
  "properties": {
    "version": { "const": "signed-receipt-claims/v3" },
    "environment": { "enum": ["production", "staging"] },
    "authority_instance_digest": { "$ref": "#/$defs/digest" },
    "coverage_policy_version": { "$ref": "#/$defs/nonempty" },
    "source": { "$ref": "#/$defs/nonempty" },
    "dataset": { "$ref": "#/$defs/nonempty" },
    "segment_id": { "$ref": "#/$defs/nonempty" },
    "segment_start": { "$ref": "#/$defs/nonempty" },
    "segment_end": { "$ref": "#/$defs/nonempty" },
    "expected_scope": { "type": "object" },
    "expected_items": {
      "oneOf": [
        { "$ref": "#/$defs/nonnegative_integer" },
        { "type": "null" }
      ]
    },
    "observed_items": { "$ref": "#/$defs/nonnegative_integer" },
    "raw_page_count": { "$ref": "#/$defs/nonnegative_integer" },
    "raw_count": { "$ref": "#/$defs/nonnegative_integer" },
    "structured_count": { "$ref": "#/$defs/nonnegative_integer" },
    "status": { "const": "SUCCESS" },
    "error": { "type": "null" },
    "pagination_exhausted": { "const": true },
    "discovery_exhausted": { "const": true },
    "source_request_digest": { "$ref": "#/$defs/digest" },
    "raw_manifest_digest": { "$ref": "#/$defs/digest" },
    "raw_digest": { "$ref": "#/$defs/digest" },
    "structured_digest": { "$ref": "#/$defs/digest" },
    "parser_normalizer_version": { "$ref": "#/$defs/nonempty" },
    "structured_generation": { "$ref": "#/$defs/nonnegative_integer" },
    "scope_digest": { "$ref": "#/$defs/digest" },
    "observation_digest": { "$ref": "#/$defs/digest" },
    "run_id": { "$ref": "#/$defs/nonnegative_integer" },
    "issuer_id": { "$ref": "#/$defs/nonempty" },
    "issued_at": { "$ref": "#/$defs/nonempty" },
    "checked_at": { "$ref": "#/$defs/nonempty" },
    "extra_digests": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "acquisition_collection_manifest_file_digest": { "$ref": "#/$defs/digest" },
        "acquisition_collection_digest": { "$ref": "#/$defs/digest" },
        "acquisition_terminal_chain_digest": { "$ref": "#/$defs/digest" },
        "official_calendar_evidence_digest": { "$ref": "#/$defs/digest" },
        "official_calendar_raw_body_digest": { "$ref": "#/$defs/digest" },
        "official_calendar_query_digest": { "$ref": "#/$defs/digest" },
        "official_business_dates_digest": { "$ref": "#/$defs/digest" },
        "official_calendar_binding_digest": { "$ref": "#/$defs/digest" }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "body_digest",
            "environment",
            "authority_instance_digest",
            "checked_at",
            "coverage_policy_version",
            "dataset",
            "discovery_exhausted",
            "eligibility",
            "error",
            "expected_items",
            "expected_scope",
            "extra_digests",
            "issued_at",
            "issuer_class",
            "issuer_id",
            "issuer_key_id",
            "observation_digest",
            "observed_items",
            "pagination_exhausted",
            "parser_normalizer_version",
            "raw",
            "raw_count",
            "raw_digest",
            "raw_manifest_digest",
            "raw_page_count",
            "run_id",
            "scope_digest",
            "segment_end",
            "segment_id",
            "segment_start",
            "signature",
            "signed_body_b64",
            "source",
            "source_request_digest",
            "status",
            "structured_count",
            "structured_digest",
            "structured_generation",
            "version"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": { "const": "jquants" }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "extra_digests": {
            "required": [
              "acquisition_collection_manifest_file_digest",
              "acquisition_collection_digest",
              "acquisition_terminal_chain_digest"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "extra_digests": {
            "not": {
              "anyOf": [
                { "required": ["acquisition_collection_manifest_file_digest"] },
                { "required": ["acquisition_collection_digest"] },
                { "required": ["acquisition_terminal_chain_digest"] },
                { "required": ["official_calendar_evidence_digest"] },
                { "required": ["official_calendar_raw_body_digest"] },
                { "required": ["official_calendar_query_digest"] },
                { "required": ["official_business_dates_digest"] },
                { "required": ["official_calendar_binding_digest"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": { "const": "jquants" },
          "dataset": { "const": "equities_master" }
        },
        "required": ["source", "dataset"]
      },
      "then": {
        "properties": {
          "extra_digests": {
            "required": [
              "official_calendar_evidence_digest",
              "official_calendar_raw_body_digest",
              "official_calendar_query_digest",
              "official_business_dates_digest",
              "official_calendar_binding_digest"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "extra_digests": {
            "not": {
              "anyOf": [
                { "required": ["official_calendar_evidence_digest"] },
                { "required": ["official_calendar_raw_body_digest"] },
                { "required": ["official_calendar_query_digest"] },
                { "required": ["official_business_dates_digest"] },
                { "required": ["official_calendar_binding_digest"] }
              ]
            }
          }
        }
      }
    }
  ]
}
