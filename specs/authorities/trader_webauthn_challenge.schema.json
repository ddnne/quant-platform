{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-platform.invalid/specs/authorities/trader_webauthn_challenge.schema.json",
  "title": "Exact-four human-present Trader WebAuthn challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "challenge_id",
    "challenge_base64url",
    "exact_four_authorization_digest",
    "rp_id",
    "origin",
    "user_presence_required",
    "user_verification_required",
    "issued_at",
    "expires_at",
    "one_use_key",
    "challenge_digest"
  ],
  "properties": {
    "schema_version": {"const": "trader-webauthn-challenge/v1"},
    "environment": {"enum": ["staging", "production"]},
    "challenge_id": {"$ref": "#/$defs/uuid4"},
    "challenge_base64url": {"$ref": "#/$defs/base64url"},
    "exact_four_authorization_digest": {"$ref": "#/$defs/sha256"},
    "rp_id": {"enum": ["staging.quant-platform.local", "quant-platform.local"]},
    "origin": {
      "enum": [
        "https://staging.quant-platform.local",
        "https://quant-platform.local"
      ]
    },
    "user_presence_required": {"const": true},
    "user_verification_required": {"const": true},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "one_use_key": {"$ref": "#/$defs/sha256"},
    "challenge_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "staging"}}, "required": ["environment"]},
      "then": {
        "properties": {
          "rp_id": {"const": "staging.quant-platform.local"},
          "origin": {"const": "https://staging.quant-platform.local"}
        }
      },
      "else": {
        "properties": {
          "rp_id": {"const": "quant-platform.local"},
          "origin": {"const": "https://quant-platform.local"}
        }
      }
    }
  ],
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,171}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
