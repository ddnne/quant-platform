{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-platform.invalid/specs/authorities/authority_event.schema.json",
  "title": "Append-only authority event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "authority_id",
    "sequence",
    "event_id",
    "idempotency_key",
    "request_id",
    "event_type",
    "subject_id",
    "prior_event_digest",
    "payload_schema",
    "payload_digest",
    "payload_json",
    "observed_at",
    "event_digest"
  ],
  "properties": {
    "schema_version": {"const": "authority-event/v2"},
    "environment": {"enum": ["staging", "production"]},
    "authority_id": {
      "enum": [
        "receipt",
        "d1_sync",
        "ops_projection",
        "coverage_transition",
        "ready",
        "trader",
        "controlled_execution"
      ]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"$ref": "#/$defs/uuid4"},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "request_id": {"$ref": "#/$defs/request_id"},
    "event_type": {
      "enum": [
        "PREPARED",
        "SIGNED",
        "PUBLISHED",
        "COMMITTED",
        "REJECTED",
        "FAILED",
        "RECONCILED",
        "ROLLBACK_DETECTED"
      ]
    },
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "prior_event_digest": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "payload_schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}/v[1-9][0-9]*$"
    },
    "payload_digest": {"$ref": "#/$defs/sha256"},
    "payload_json": {"type": "string", "minLength": 2, "maxLength": 1048576},
    "observed_at": {"type": "string", "format": "date-time"},
    "event_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"prior_event_digest": {"type": "null"}}},
      "else": {"properties": {"prior_event_digest": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_id": {
      "oneOf": [{"$ref": "#/$defs/uuid4"}, {"$ref": "#/$defs/sha256"}]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
