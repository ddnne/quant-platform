{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "specs/experiment_plans/schema.json",
  "title": "ExperimentPlan",
  "description": "Closed ExperimentPlan v1. Unknown fields fail. execution_enabled is const false. Not a catalog rewrite and not a mass start.",
  "$comment": "Exactly four typed plans live beside this schema. Pilot start stays off. Do not dump the active catalog into this directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plan_id",
    "idea_id",
    "hypothesis",
    "strategy_spec_id",
    "feature_refs",
    "research_data_profile_id",
    "ready_snapshot_id",
    "universe",
    "period_start",
    "period_end",
    "cost_scenario",
    "evaluation_protocol",
    "budget_allocation",
    "execution_enabled"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "experiment-plan/v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "idea_id": {
      "type": "string",
      "minLength": 1,
      "description": "Human ResearchIdea id. Not a catalog logic_id dump."
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "description": "Human idea text."
    },
    "strategy_spec_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "research_data_profile_id": {
      "type": "string",
      "const": "core"
    },
    "ready_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "READY is not declared. This is not a live snapshot grant."
    },
    "universe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "period_start": {
      "type": "string",
      "minLength": 1
    },
    "period_end": {
      "type": "string",
      "minLength": 1
    },
    "cost_scenario": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_protocol": {
      "type": "string",
      "minLength": 1
    },
    "budget_allocation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer"
      }
    },
    "execution_enabled": {
      "type": "boolean",
      "const": false,
      "description": "Pilot execution switch. Must stay false."
    }
  }
}
