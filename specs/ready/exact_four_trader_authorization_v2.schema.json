{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-platform.local/specs/ready/exact_four_trader_authorization_v2.schema.json",
  "title": "Exact-four Trader pre-approval and authorization envelope v2",
  "oneOf": [
    { "$ref": "#/$defs/approvalSubject" },
    { "$ref": "#/$defs/authorizationEnvelope" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base64url": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10923,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "rpId": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{1,62}$"
    },
    "httpsOrigin": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[1-9][0-9]{0,4})?$"
    },
    "approvalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authority_scope",
        "execution_mode",
        "pilot_run_id",
        "readiness_attestation_id",
        "snapshot_id",
        "ready_manifest_digest",
        "immutable_snapshot_digest",
        "exact_four_binding_digest",
        "controlled_pilot_policy_digest",
        "budget_scope_digest",
        "execution_limit_set_digest",
        "lease_ttl_seconds",
        "ready_issued_at",
        "ready_expires_at",
        "automatic_promotion",
        "mass_research_enabled",
        "live_trading_enabled",
        "approval_subject_id"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-approval-subject/v2" },
        "authority_scope": { "const": "EXACT_FOUR_TRADER_PRE_APPROVAL" },
        "execution_mode": { "const": "paper" },
        "pilot_run_id": { "$ref": "#/$defs/nonEmpty" },
        "readiness_attestation_id": { "$ref": "#/$defs/digest" },
        "snapshot_id": { "$ref": "#/$defs/digest" },
        "ready_manifest_digest": { "$ref": "#/$defs/digest" },
        "immutable_snapshot_digest": { "$ref": "#/$defs/digest" },
        "exact_four_binding_digest": { "$ref": "#/$defs/digest" },
        "controlled_pilot_policy_digest": {
          "const": "sha256:60fc8438f7dd4914c9fec99ae53476b9a514a80d0411b7ab07dc7e9963d5f319"
        },
        "budget_scope_digest": { "$ref": "#/$defs/digest" },
        "execution_limit_set_digest": { "$ref": "#/$defs/digest" },
        "lease_ttl_seconds": { "type": "integer", "const": 1800 },
        "ready_issued_at": { "type": "string", "format": "date-time" },
        "ready_expires_at": { "type": "string", "format": "date-time" },
        "automatic_promotion": { "const": false },
        "mass_research_enabled": { "const": false },
        "live_trading_enabled": { "const": false },
        "approval_subject_id": { "$ref": "#/$defs/digest" }
      }
    },
    "challengeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "environment",
        "status",
        "challenge_id",
        "challenge_base64url",
        "approval_subject_id",
        "rp_policy_generation",
        "rp_policy_digest",
        "rp_id",
        "origin",
        "user_presence_required",
        "user_verification_required",
        "issued_at",
        "expires_at",
        "one_use_key",
        "challenge_digest"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-webauthn-challenge/v2" },
        "environment": { "enum": ["staging", "production"] },
        "status": { "const": "ISSUED" },
        "challenge_id": { "$ref": "#/$defs/uuid4" },
        "challenge_base64url": { "$ref": "#/$defs/base64url" },
        "approval_subject_id": { "$ref": "#/$defs/digest" },
        "rp_policy_generation": { "type": "integer", "minimum": 1 },
        "rp_policy_digest": { "$ref": "#/$defs/digest" },
        "rp_id": { "$ref": "#/$defs/rpId" },
        "origin": { "$ref": "#/$defs/httpsOrigin" },
        "user_presence_required": { "const": true },
        "user_verification_required": { "const": true },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "one_use_key": { "$ref": "#/$defs/digest" },
        "challenge_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "assertionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "environment",
        "status",
        "challenge_id",
        "challenge_digest",
        "approval_subject_id",
        "rp_policy_generation",
        "rp_policy_digest",
        "credential_id_base64url",
        "authenticator_data_base64url",
        "client_data_json_base64url",
        "signature_base64url",
        "rp_id",
        "origin",
        "user_present",
        "user_verified",
        "sign_count",
        "asserted_at",
        "one_use_key",
        "assertion_digest"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-webauthn-assertion/v2" },
        "environment": { "enum": ["staging", "production"] },
        "status": { "const": "VERIFIED" },
        "challenge_id": { "$ref": "#/$defs/uuid4" },
        "challenge_digest": { "$ref": "#/$defs/digest" },
        "approval_subject_id": { "$ref": "#/$defs/digest" },
        "rp_policy_generation": { "type": "integer", "minimum": 1 },
        "rp_policy_digest": { "$ref": "#/$defs/digest" },
        "credential_id_base64url": { "$ref": "#/$defs/base64url" },
        "authenticator_data_base64url": { "$ref": "#/$defs/base64url" },
        "client_data_json_base64url": { "$ref": "#/$defs/base64url" },
        "signature_base64url": { "$ref": "#/$defs/base64url" },
        "rp_id": { "$ref": "#/$defs/rpId" },
        "origin": { "$ref": "#/$defs/httpsOrigin" },
        "user_present": { "const": true },
        "user_verified": { "const": true },
        "sign_count": { "type": "integer", "minimum": 0 },
        "asserted_at": { "type": "string", "format": "date-time" },
        "one_use_key": { "$ref": "#/$defs/digest" },
        "assertion_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "credentialRegistryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "environment",
        "evidence_status",
        "credential_status",
        "registry_id",
        "registry_generation",
        "registry_digest",
        "rp_policy_id",
        "rp_policy_generation",
        "rp_policy_digest",
        "rp_id",
        "origin",
        "credential_id_base64url",
        "credential_public_key_digest",
        "credential_algorithm",
        "key_backend",
        "counter_mode",
        "stored_sign_count",
        "effective_at",
        "observed_at",
        "verification_backend_id",
        "verification_backend_version",
        "verification_backend_generation",
        "verification_event_id",
        "verification_event_digest",
        "evidence_digest"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-credential-registry-evidence/v2" },
        "environment": { "enum": ["staging", "production"] },
        "evidence_status": { "const": "PASS" },
        "credential_status": { "const": "ACTIVE" },
        "registry_id": { "const": "exact-four-trader-webauthn-credentials/v2" },
        "registry_generation": { "type": "integer", "minimum": 1 },
        "registry_digest": { "$ref": "#/$defs/digest" },
        "rp_policy_id": { "const": "exact-four-trader-rp-policy/v2" },
        "rp_policy_generation": { "type": "integer", "minimum": 1 },
        "rp_policy_digest": { "$ref": "#/$defs/digest" },
        "rp_id": { "$ref": "#/$defs/rpId" },
        "origin": { "$ref": "#/$defs/httpsOrigin" },
        "credential_id_base64url": { "$ref": "#/$defs/base64url" },
        "credential_public_key_digest": { "$ref": "#/$defs/digest" },
        "credential_algorithm": { "enum": ["ES256", "EdDSA"] },
        "key_backend": { "const": "webauthn_platform_or_hardware" },
        "counter_mode": { "enum": ["COUNTING", "COUNTERLESS"] },
        "stored_sign_count": { "type": "integer", "minimum": 0 },
        "effective_at": { "type": "string", "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" },
        "verification_backend_id": {
          "const": "ExactFourTraderWebAuthnVerifier/v2"
        },
        "verification_backend_version": { "const": "v2" },
        "verification_backend_generation": { "type": "integer", "minimum": 1 },
        "verification_event_id": { "$ref": "#/$defs/uuid4" },
        "verification_event_digest": { "$ref": "#/$defs/digest" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "oneUseLedgerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "environment",
        "ledger_id",
        "ledger_backend_id",
        "ledger_generation",
        "ledger_transaction_id",
        "ledger_transaction_digest",
        "transaction_status",
        "transaction_committed_at",
        "event_id",
        "approval_subject_id",
        "challenge_id",
        "challenge_digest",
        "assertion_digest",
        "one_use_key",
        "credential_id_base64url",
        "credential_registry_generation",
        "credential_registry_digest",
        "counter_mode",
        "prior_sign_count",
        "asserted_sign_count",
        "result_sign_count",
        "one_use_prior_status",
        "one_use_result_status",
        "one_use_cas_status",
        "counter_cas_status",
        "consumed_at",
        "event_digest"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-one-use-ledger-event/v2" },
        "environment": { "enum": ["staging", "production"] },
        "ledger_id": { "const": "exact-four-trader-one-use-ledger/v2" },
        "ledger_backend_id": { "const": "ExactFourTraderOneUseLedger/v2" },
        "ledger_generation": { "type": "integer", "minimum": 1 },
        "ledger_transaction_id": { "$ref": "#/$defs/uuid4" },
        "ledger_transaction_digest": { "$ref": "#/$defs/digest" },
        "transaction_status": { "const": "COMMITTED" },
        "transaction_committed_at": { "type": "string", "format": "date-time" },
        "event_id": { "$ref": "#/$defs/uuid4" },
        "approval_subject_id": { "$ref": "#/$defs/digest" },
        "challenge_id": { "$ref": "#/$defs/uuid4" },
        "challenge_digest": { "$ref": "#/$defs/digest" },
        "assertion_digest": { "$ref": "#/$defs/digest" },
        "one_use_key": { "$ref": "#/$defs/digest" },
        "credential_id_base64url": { "$ref": "#/$defs/base64url" },
        "credential_registry_generation": { "type": "integer", "minimum": 1 },
        "credential_registry_digest": { "$ref": "#/$defs/digest" },
        "counter_mode": { "enum": ["COUNTING", "COUNTERLESS"] },
        "prior_sign_count": { "type": "integer", "minimum": 0 },
        "asserted_sign_count": { "type": "integer", "minimum": 0 },
        "result_sign_count": { "type": "integer", "minimum": 0 },
        "one_use_prior_status": { "const": "AVAILABLE" },
        "one_use_result_status": { "const": "CONSUMED" },
        "one_use_cas_status": { "const": "APPLIED" },
        "counter_cas_status": { "enum": ["APPLIED", "NOT_APPLICABLE"] },
        "consumed_at": { "type": "string", "format": "date-time" },
        "event_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "environment",
        "authority_id",
        "sequence",
        "event_id",
        "idempotency_key",
        "request_id",
        "event_type",
        "subject_id",
        "prior_event_digest",
        "payload_schema",
        "payload_digest",
        "payload_json",
        "observed_at",
        "event_digest"
      ],
      "properties": {
        "schema_version": { "const": "authority-event/v2" },
        "environment": { "enum": ["staging", "production"] },
        "authority_id": { "const": "trader" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/uuid4" },
        "idempotency_key": { "$ref": "#/$defs/digest" },
        "request_id": { "$ref": "#/$defs/digest" },
        "event_type": { "const": "COMMITTED" },
        "subject_id": { "$ref": "#/$defs/digest" },
        "prior_event_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "payload_schema": {
          "const": "exact-four-trader-authority-event-payload/v2"
        },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "payload_json": { "type": "string", "minLength": 2, "maxLength": 65536 },
        "observed_at": { "type": "string", "format": "date-time" },
        "event_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sequence": { "const": 1 } },
            "required": ["sequence"]
          },
          "then": {
            "properties": { "prior_event_digest": { "type": "null" } }
          },
          "else": {
            "properties": {
              "prior_event_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      ]
    },
    "authorizationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "issuer",
        "authority_scope",
        "execution_mode",
        "approval_subject_id",
        "authorization_decision_id",
        "issuer_key_id",
        "issuer_key_algorithm",
        "issuer_key_backend",
        "issuer_key_registry_generation",
        "issuer_key_registry_digest",
        "issuer_backend_id",
        "issuer_backend_generation",
        "authorization_status",
        "challenge_evidence",
        "assertion_evidence",
        "credential_registry_evidence",
        "one_use_ledger_event",
        "authority_event",
        "issued_at",
        "expires_at",
        "automatic_promotion",
        "mass_research_enabled",
        "live_trading_enabled",
        "authorization_id"
      ],
      "properties": {
        "format": { "const": "exact-four-trader-authorization-envelope/v2" },
        "issuer": { "const": "ExactFourTraderAuthorizationAuthority/v2" },
        "authority_scope": { "const": "EXACT_FOUR_TRADER_AUTHORIZATION" },
        "execution_mode": { "const": "paper" },
        "approval_subject_id": { "$ref": "#/$defs/digest" },
        "authorization_decision_id": { "$ref": "#/$defs/digest" },
        "issuer_key_id": { "$ref": "#/$defs/base64url" },
        "issuer_key_algorithm": { "enum": ["ES256", "EdDSA"] },
        "issuer_key_backend": { "const": "webauthn_platform_or_hardware" },
        "issuer_key_registry_generation": { "type": "integer", "minimum": 1 },
        "issuer_key_registry_digest": { "$ref": "#/$defs/digest" },
        "issuer_backend_id": {
          "const": "ExactFourTraderAuthorizationAuthorityBackend/v2"
        },
        "issuer_backend_generation": { "type": "integer", "minimum": 1 },
        "authorization_status": { "const": "AUTHORIZED" },
        "challenge_evidence": { "$ref": "#/$defs/challengeEvidence" },
        "assertion_evidence": { "$ref": "#/$defs/assertionEvidence" },
        "credential_registry_evidence": {
          "$ref": "#/$defs/credentialRegistryEvidence"
        },
        "one_use_ledger_event": { "$ref": "#/$defs/oneUseLedgerEvent" },
        "authority_event": { "$ref": "#/$defs/authorityEvent" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "automatic_promotion": { "const": false },
        "mass_research_enabled": { "const": false },
        "live_trading_enabled": { "const": false },
        "authorization_id": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
