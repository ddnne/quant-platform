{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "specs/receipts/signed_receipt_claims.schema.json",
  "title": "SignedReceiptClaims",
  "description": "Closed signed-body claims for a collection receipt. extra_digests is a separate namespace and cannot override standard claims.",
  "$comment": "Unknown fields fail (additionalProperties: false). version is the const signed-receipt-claims/v1. extra_digests property names must not collide with standard claims or the signature envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dataset",
    "source",
    "segment_id",
    "segment_start",
    "segment_end",
    "source_request_digest",
    "raw_manifest_digest",
    "raw_digest",
    "raw_count",
    "structured_digest",
    "structured_count",
    "parser_normalizer_version",
    "structured_generation",
    "pagination_exhausted",
    "discovery_exhausted",
    "run_id",
    "issuer_id",
    "issued_at",
    "checked_at",
    "extra_digests"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "signed-receipt-claims/v1"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "segment_start": {
      "type": ["string", "null"]
    },
    "segment_end": {
      "type": ["string", "null"]
    },
    "source_request_digest": {
      "type": ["string", "null"]
    },
    "raw_manifest_digest": {
      "type": ["string", "null"]
    },
    "raw_digest": {
      "type": "string",
      "minLength": 1
    },
    "raw_count": {
      "type": "integer"
    },
    "structured_digest": {
      "type": ["string", "null"]
    },
    "structured_count": {
      "type": "integer"
    },
    "parser_normalizer_version": {
      "type": "string",
      "minLength": 1
    },
    "structured_generation": {
      "type": ["integer", "null"]
    },
    "pagination_exhausted": {
      "type": "boolean"
    },
    "discovery_exhausted": {
      "type": "boolean"
    },
    "run_id": {
      "type": "integer"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "extra_digests": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "body_digest",
            "checked_at",
            "dataset",
            "discovery_exhausted",
            "eligibility",
            "extra_digests",
            "issued_at",
            "issuer_class",
            "issuer_id",
            "issuer_key_id",
            "pagination_exhausted",
            "parser_normalizer_version",
            "raw",
            "raw_count",
            "raw_digest",
            "raw_manifest_digest",
            "run_id",
            "segment_end",
            "segment_id",
            "segment_start",
            "signature",
            "signed_body_b64",
            "source",
            "source_request_digest",
            "structured_count",
            "structured_digest",
            "structured_generation",
            "version"
          ]
        }
      }
    }
  }
}
