{
  "name": "quant-platform-research-mass-eval",
  "private": true,
  "version": "0.1.0",
  "description": "W90 — multi-logic lite multi-period mass-eval on Cloudflare Workers",
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "scripts": {
    "deploy": "wrangler deploy --config=wrangler.toml --env=production",
    "dev": "wrangler dev --config=wrangler.toml --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "vitest run --config vitest.runtime.config.mts",
    "build": "wrangler deploy --dry-run --config=wrangler.toml --env=\"\" --outdir .wrangler-dry-run",
    "tail": "wrangler tail --config=wrangler.toml --env=production",
    "types": "wrangler types --config=wrangler.toml --env=\"\" --include-runtime false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
