#!/usr/bin/env python3
"""Installed launcher for the repository's multi-root Python layout."""

from __future__ import annotations

import sys
from pathlib import Path


def _repository_root() -> Path | None:
    starts = (Path(__file__).resolve(), Path.cwd().resolve())
    visited: set[Path] = set()
    for start in starts:
        for candidate in (start.parent, *start.parents):
            if candidate in visited:
                continue
            visited.add(candidate)
            if (
                (candidate / "pyproject.toml").is_file()
                and (candidate / "packages" / "product" / "research").is_dir()
            ):
                return candidate
    return None


def _main() -> int:
    root = _repository_root()
    if root is None:
        print(
            "qp-research: this v1 command must be run from a quant-platform "
            "checkout (or its .venv)",
            file=sys.stderr,
        )
        return 2
    sys.path[:0] = [
        str(root),
        str(root / "packages" / "edge"),
        str(root / "packages" / "data_plane"),
        str(root / "packages" / "research_runtime"),
        str(root / "packages" / "product"),
    ]
    from cf_platform.personal_offline_cli import main

    return main()


if __name__ == "__main__":
    raise SystemExit(_main())
